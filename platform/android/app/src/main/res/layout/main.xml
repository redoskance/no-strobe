<?xml version="1.0" encoding="utf-8"?>
<!-- Open Camera style: the viewfinder keeps the video's own ratio (9:16 here), everything else is a
     translucent overlay. Same view ids as layout-land/main.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <dev.nostrobe.AspectFrameLayout
        android:id="@+id/aspectLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <dev.nostrobe.GridOverlay
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="96sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/focusRing"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="focus"
            android:src="@drawable/focus_ring"
            android:visibility="gone" />

        <View
            android:id="@+id/shutterFlash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFFFF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_chip"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="search"
            android:textColor="@color/m3_on_surface"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

        <TextView
            android:id="@+id/gridToggle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:drawableTint="@color/icon_tint"
            android:drawableTop="@drawable/ic_grid"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="grid"
            android:textColor="@color/icon_tint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/timer"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:drawableTint="@color/icon_tint"
            android:drawableTop="@drawable/ic_timer"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="timer"
            android:textColor="@color/icon_tint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/mic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:drawableTint="@color/icon_tint"
            android:drawableTop="@drawable/ic_mic"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="mic"
            android:textColor="@color/icon_tint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/evToggle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:drawableTint="@color/icon_tint"
            android:drawableTop="@drawable/ic_ev"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="EV"
            android:textColor="@color/icon_tint"
            android:textSize="10sp" />
        </LinearLayout>
    </dev.nostrobe.AspectFrameLayout>

    <dev.nostrobe.MaxWidthLinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_bottom_fade"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/evPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:text="EV"
                android:textColor="@color/m3_on_surface" />

            <SeekBar
                android:id="@+id/exposureBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="0" />

            <TextView
                android:id="@+id/exposureText"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="+0.0 EV"
                android:textColor="@color/m3_on_surface" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/lensRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <SeekBar
                android:id="@+id/zoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/zoomText"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="1.0x"
                android:textColor="@color/m3_on_surface" />
        </LinearLayout>

        <!-- Mode switcher on top of the shutter button: VIDÉO / PHOTO -->
        <LinearLayout
            android:id="@+id/modeSwitchRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_lens_chip"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="3dp">

            <TextView
                android:id="@+id/modeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_strip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:text="VIDÉO"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:text="PHOTO"
                android:textColor="@color/m3_on_surface"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/post"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tool"
                android:clickable="true"
                android:drawableTint="@color/icon_tint"
                android:drawableTop="@drawable/ic_gallery"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:paddingTop="8dp"
                android:text="galerie"
                android:textColor="@color/icon_tint"
                android:textSize="10sp"
                android:visibility="gone" />

            <View
                android:id="@+id/photo"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="72dp"
                android:background="@drawable/capture_photo"
                android:clickable="true"
                android:contentDescription="photo"
                android:focusable="true" />

            <View
                android:id="@+id/record"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/capture_button"
                android:clickable="true"
                android:contentDescription="record"
                android:focusable="true" />

            <TextView
                android:id="@+id/flip"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_tool"
                android:clickable="true"
                android:drawableTint="@color/icon_tint"
                android:drawableTop="@drawable/ic_flip"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:paddingTop="8dp"
                android:text="flip"
                android:textColor="@color/icon_tint"
                android:textSize="10sp" />
        </FrameLayout>
    </dev.nostrobe.MaxWidthLinearLayout>

</FrameLayout>
