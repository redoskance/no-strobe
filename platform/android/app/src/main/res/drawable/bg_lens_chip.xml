<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/m3_primary">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/m3_primary_container" />
                    <stroke android:width="1.5dp" android:color="@color/m3_primary" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/m3_glass_pill" />
                    <stroke android:width="1dp" android:color="@color/m3_glass_stroke" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
