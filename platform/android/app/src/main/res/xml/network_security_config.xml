<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Public cleartext traffic (HTTP) is disabled by default for security -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Cleartext permitted only for local development, loopback, and LAN server offload -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">lan</domain>
        <domain includeSubdomains="true">home.arpa</domain>
        <domain includeSubdomains="true">internal</domain>
        <!-- Common local dev endpoints -->
        <domain includeSubdomains="false">192.168.69.69</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
    </domain-config>
</network-security-config>
