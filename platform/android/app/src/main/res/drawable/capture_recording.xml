<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pulsing Outer Ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33EF4444" />
            <stroke android:width="3.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <!-- Square Stop Icon -->
    <item
        android:bottom="22dp"
        android:left="22dp"
        android:right="22dp"
        android:top="22dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_status_recording" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
