<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/galleryBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="← Caméra"
            android:textColor="@color/m3_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/galleryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="Galerie Avant / Après"
            android:textColor="@color/m3_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/galleryShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="↗"
            android:textColor="@color/m3_on_surface"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/galleryDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🗑"
            android:textColor="#DC2626"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Video Viewport -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <VideoView
            android:id="@+id/videoPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Status / Mode Badge Overlay -->
        <TextView
            android:id="@+id/modeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_lens_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="AVANT (ORIGINAL)"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Play / Pause Center Overlay -->
        <TextView
            android:id="@+id/playPauseOverlay"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_strip"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:visibility="gone" />

        <!-- Processing Progress Overlay -->
        <LinearLayout
            android:id="@+id/postProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/postProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="200dp"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/postProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Post-traitement en local: 0 %"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Correction anti-banding et pompage luma"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Playback Seekbar & Timestamps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/timeCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/videoSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/timeTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Comparison & Action Controls -->
    <LinearLayout
        android:id="@+id/comparisonBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <!-- When Fixed is available: Avant / Après toggles -->
        <LinearLayout
            android:id="@+id/comparisonToggles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBefore"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Avant (Original)"
                android:textColor="@color/m3_on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAfter"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Après (Corrigé)"
                android:textColor="@color/m3_on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHoldCompare"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_strip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Maintenir (Avant)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- When Fixed is NOT yet generated: Action button -->
        <LinearLayout
            android:id="@+id/notFixedActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnProcessLocal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_strip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⚡ Post-traiter en local"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnProcessDesktop"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_tool"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Desktop"
                android:textColor="@color/m3_on_surface"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Carousel / Strip for All Recorded Clips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/m3_surface_container"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="4dp"
            android:text="Clips récents"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/clipsStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
