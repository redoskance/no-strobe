<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is allowed by the platform and refused by the app towards anything that is not on the local
         network (LanPolicy): a config can list hosts but cannot say "any private address", and a list of a few
         addresses blocked the LAN offload for every other server. HTTPS is used as is. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
