<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape (a phone on its side, a foldable opened flat): the viewfinder in 16:9, the shutter in a
     strip on the right edge like Open Camera, the tools as a row over the top of the picture. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="104dp">

        <dev.nostrobe.AspectFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <dev.nostrobe.GridOverlay
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="96sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/focusRing"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="focus"
            android:src="@drawable/focus_ring"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_chip"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="search"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:orientation="horizontal">

            <TextView
            android:id="@+id/gridToggle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:drawableTint="@color/icon_tint"
            android:drawableTop="@drawable/ic_grid"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="grid"
            android:textColor="@color/icon_tint"
            android:textSize="10sp" />

            <TextView
            android:id="@+id/timer"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:drawableTint="@color/icon_tint"
            android:drawableTop="@drawable/ic_timer"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="timer"
            android:textColor="@color/icon_tint"
            android:textSize="10sp" />

            <TextView
            android:id="@+id/mic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:drawableTint="@color/icon_tint"
            android:drawableTop="@drawable/ic_mic"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="mic"
            android:textColor="@color/icon_tint"
            android:textSize="10sp" />

            <TextView
            android:id="@+id/evToggle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:drawableTint="@color/icon_tint"
            android:drawableTop="@drawable/ic_ev"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="EV"
            android:textColor="@color/icon_tint"
            android:textSize="10sp" />
            </LinearLayout>

    <dev.nostrobe.MaxWidthLinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_bottom_fade"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/evPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:text="EV"
                android:textColor="#FFFFFFFF" />

            <SeekBar
                android:id="@+id/exposureBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="0" />

            <TextView
                android:id="@+id/exposureText"
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="+0.0 EV"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/lensRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <SeekBar
                android:id="@+id/zoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/zoomText"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="1.0x"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

    </dev.nostrobe.MaxWidthLinearLayout>

        </dev.nostrobe.AspectFrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="104dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_strip"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/post"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:drawableTint="@color/icon_tint"
            android:drawableTop="@drawable/ic_post"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="post"
            android:textColor="@color/icon_tint"
            android:textSize="10sp" android:visibility="gone" />

        <View
                android:id="@+id/record"
                android:layout_width="76dp"
                android:layout_margin="10dp"
                android:layout_height="76dp"
                android:background="@drawable/capture_button"
                android:clickable="true"
                android:contentDescription="record"
                android:focusable="true" />

        <TextView
            android:id="@+id/flip"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_tool"
            android:clickable="true"
            android:drawableTint="@color/icon_tint"
            android:drawableTop="@drawable/ic_flip"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:text="flip"
            android:textColor="@color/icon_tint"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
